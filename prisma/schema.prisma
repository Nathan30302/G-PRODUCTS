generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum StockStatus {
  in_stock
  low_stock
  sold_out
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(STAFF)
  /// Owner-written job title, e.g. "Orders & uploads", "Shop floor"
  staffTitle   String?
  createdAt    DateTime @default(now())
}

/// Storefront customer accounts (separate from staff User / Provider desk)
model Customer {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String   @unique
  firstName       String
  lastName        String
  /// Display name (first + last) — kept for orders and legacy reads
  name            String
  passwordHash    String
  /// Saved delivery spot, e.g. "Kalingalinga Block A Room 12" or home address
  defaultLocation String?
  locationLabel   String?
  /// G-Rewards points (1 point ≈ K1 spent when paid)
  rewardPoints    Int      @default(0)
  /// Unique share code for referrals (e.g. GP-A1B2C3)
  referralCode    String?  @unique
  /// Code used at signup (who referred this customer)
  referredByCode  String?
  orders          Order[]
  reviews         ProductReview[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  tagline   String
  icon      String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  brand          String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  price          Int
  compareAtPrice Int?
  description    String
  shortSpecs     String // JSON-encoded string[]
  stock          StockStatus     @default(in_stock) // overall status (derived from variants when present)
  featured       Boolean         @default(false)
  hotDeal        Boolean         @default(false)
  images         ProductImage[]
  variants       ProductVariant[]
  stockNotifies  StockNotify[]
  reviews        ProductReview[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String
  sortOrder Int             @default(0)
}

/// Colour / size / option variants with their own quantity (and optional price)
model ProductVariant {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // e.g. Black, or "3-way · 3m"
  colorHex  String? // e.g. #111111 for colour swatch
  /// When set, this option has its own price (ZMW). Otherwise product.price is used.
  price     Int?
  quantity  Int            @default(0)
  sortOrder Int            @default(0)
  images    ProductImage[]
}

/// Customer asked to be notified when a sold-out item/variant is back
model StockNotify {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  contact   String // phone or email
  createdAt DateTime @default(now())
}

model Order {
  id            String        @id @default(cuid())
  ref           String        @unique
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  address       String?
  total         Int
  status        OrderStatus   @default(PENDING)
  paymentMethod String // mtn | airtel | zamtel
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String? // provider transaction/reference id
  note          String?
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  price     Int
  qty       Int
}

enum ServiceType {
  KEY_CUTTING
  G_LOANS
  PRINTING
}

enum DeliveryMethod {
  PICKUP
  YANGO
}

enum ServiceStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model ServiceRequest {
  id              String          @id @default(cuid())
  ref             String          @unique
  serviceType     ServiceType
  customerName    String
  customerPhone   String
  deliveryMethod  DeliveryMethod  @default(PICKUP)
  address         String?
  details         String // JSON payload (key types, loan amount, print options, etc.)
  fileUrls        String? // JSON string[] of uploaded file paths (printing)
  amount          Int? // ZMW total when payable
  status          ServiceStatus   @default(NEW)
  paymentMethod   String? // mtn | airtel | zamtel
  paymentStatus   PaymentStatus?
  paymentRef      String?
  orderId         String?
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

/// Editable service offerings shown on /services (admin can change photos, copy, prices)
model ServiceOffer {
  id          String   @id @default(cuid())
  slug        String   @unique
  serviceType ServiceType
  name        String
  tagline     String
  description String
  icon        String
  imageUrl    String
  priceLabel  String?
  payable     Boolean  @default(true)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// JSON: keyCuttingPrice, yangoLegFee, printBw, printColor, loanMin, loanRates
  settings    String   @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Genuine customer product reviews (optional after purchase or general feedback)
model ProductReview {
  id               String    @id @default(cuid())
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug      String
  productName      String
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName       String
  rating           Int
  title            String?
  body             String
  verifiedPurchase Boolean   @default(false)
  orderRef         String?
  /// Hidden until owner publishes (spam control)
  published        Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([productSlug, published])
}

/// Extra photos for a physical shop location (keyed to siteConfig.locations[].id)
model ShopLocationMedia {
  id        String   @id @default(cuid())
  /// e.g. unza-main, kalingalinga
  locationId String  @unique
  /// JSON string[] of image URLs
  photoUrls String   @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Public-facing team members (provider desk manages photos & titles)
model ShopTeamMember {
  id        String   @id @default(cuid())
  name      String
  title     String
  photoUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

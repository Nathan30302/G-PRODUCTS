# Database
# Local: SQLite file. On Railway, mount a volume at /data and set:
#   DATABASE_URL="file:/data/gproducts.db"
# (npm run start:prod defaults to /data when that folder exists)
DATABASE_URL="file:./dev.db"

# Auth - set a long random string (REQUIRED in production / Railway)
AUTH_SECRET="change-me-to-a-long-random-string"

# Default owner account created by the seed script
OWNER_EMAIL="gift@gproducts.zm"
OWNER_NAME="Gift Mbumwae"
OWNER_PASSWORD="changeme123"

# Extra emails allowed to create a Provider desk account via Profile signup
# (comma-separated). OWNER_EMAIL is always included. Staff never self-signup.
# PROVIDER_SIGNUP_EMAILS="gift@gmail.com,owner@company.com"

# Public base URL (payment callbacks) — set to your Railway public URL
NEXT_PUBLIC_BASE_URL="http://127.0.0.1:3000"

# --- Payments (leave blank for MANUAL/WhatsApp confirmation mode) ---

# MTN MoMo Collections (https://momodeveloper.mtn.com)
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_ENV="sandbox"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_CURRENCY="EUR"

# Airtel Money Collections (https://developers.airtel.africa)
AIRTEL_BASE_URL="https://openapiuat.airtel.africa"
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""

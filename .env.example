# Database
# Local: SQLite file. On Railway/production: attach a Volume at /data, then:
#   DATABASE_URL="file:/data/gproducts.db"
# Without a real volume, SQLite lives on the container disk and is WIPED on every deploy
# (accounts + owner password appear to "reset"). Or use managed Postgres/Neon instead.
DATABASE_URL="file:./dev.db"

# Auth - set a long random string (REQUIRED in production). Keep it STABLE —
# changing AUTH_SECRET logs everyone out (invalidates sessions).
AUTH_SECRET="change-me-to-a-long-random-string"

# Provider desk login — created once when missing. Never overwrites an existing password.
OWNER_EMAIL="gift@gproducts.zm"
OWNER_NAME="Gift Mbumwae"
OWNER_PASSWORD="changeme123"
# Leave OWNER_SYNC_PASSWORD unset. Set to "1" only for a one-shot password recovery,
# then remove it — otherwise env must not overwrite the desk password in the DB.
# OWNER_SYNC_PASSWORD="1"

# Extra emails allowed to create a Provider desk account via Profile signup
# (only if no provider exists yet). Staff never self-signup.
# PROVIDER_SIGNUP_EMAILS="gift@gmail.com"

# Public base URL (payment callbacks + SEO) — production:
# NEXT_PUBLIC_BASE_URL="https://www.g-products.store"
NEXT_PUBLIC_BASE_URL="http://127.0.0.1:3000"

# Optional. Leave unset for host-only session cookies (recommended — more
# reliable on mobile Safari). Apex already redirects to www.
# COOKIE_DOMAIN=".g-products.store"

# Required in production when live payment webhooks are enabled. Providers must
# send this value as the X-Payment-Callback-Secret header (or ?secret= query).
# PAYMENT_CALLBACK_SECRET="long-random-string"

# --- Payments (leave blank for MANUAL/WhatsApp confirmation mode) ---

# MTN MoMo Collections (https://momodeveloper.mtn.com)
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_ENV="sandbox"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_CURRENCY="EUR"

# Airtel Money Collections (https://developers.airtel.africa)
AIRTEL_BASE_URL="https://openapiuat.airtel.africa"
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
AIRTEL_COUNTRY="ZM"
AIRTEL_CURRENCY="ZMW"

# Zamtel Kwacha
ZAMTEL_BASE_URL=""
ZAMTEL_API_KEY=""
